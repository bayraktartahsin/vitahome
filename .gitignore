# Credentials — never commit. `git add -A` is routine here, so these patterns
# are the thing standing between a keys file and a public repository.
keys
keys.*
*keys.rtf
*.key
*credentials*.json

# Secrets — never commit
.env
.env.*
!.env.example
service-account*.json
gcp-key*.json

# OS / IDE
.DS_Store
.vscode/
.idea/
.claude/

# Local data
data/
*.db
*.sqlite

# TS incremental build cache
*.tsbuildinfo
