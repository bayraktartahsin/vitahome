# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models (measured: flash-lite 1.03s, 3.7-flash 2.35s on discharge extraction)
MODEL_FAST=gemini-3.5-flash-lite
MODEL_REASON=gemini-3.7-flash

# GCP
GCP_PROJECT=gen-lang-client-0109591583
REGION=us-central1

# Healthcare API (FHIR R4)
HC_LOCATION=us-central1
HC_DATASET=vitahome
HC_FHIR_STORE=clinical

# Fleet runtime
LEASE_SECONDS=60
HEARTBEAT_SECONDS=5
DRILL_SLOW_SECONDS=0     # >0 opens a kill window between steps (demo only)
PARSER_CONFIDENCE_FLOOR=0.85

PORT=8080
LOG_LEVEL=INFO
